#!/bin/bash
# Resuming from hibernate goes through the firmware, which consumes
# gpu-power-prefs and powers the dGPU back on. Re-apply the persisted choices
# afterwards (no-op after a plain suspend: the variable still reads back and
# apple_gmux restores the dGPU power state itself).
[[ ${1:-} == post ]] || exit 0
exec /usr/local/lib/omarchy-gpu-switch-apply
